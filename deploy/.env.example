# Domain Caddy will serve and request a Let's Encrypt cert for.
DOMAIN=app.yourdomain.com

# RDS Postgres connection string. Format: postgresql+asyncpg://USER:PASS@HOST:5432/DBNAME
DATABASE_URL=postgresql+asyncpg://trajan:CHANGEME@your-rds-endpoint.rds.amazonaws.com:5432/trajan_training

# 32+ char random string used to sign JWTs. `openssl rand -hex 32` to generate.
SECRET_KEY=CHANGEME-must-be-at-least-32-characters-long

# Anthropic API key for Claude.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Bootstrap admin account created on first startup if no admin exists.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGEME-strong-password

# S3 bucket for recordings.
S3_BUCKET=trajan-advisor-recordings
AWS_REGION=us-east-1

# Leave these empty on EC2 (uses instance role). Set them only for non-EC2 hosts.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
